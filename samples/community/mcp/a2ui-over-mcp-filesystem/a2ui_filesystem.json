[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "fs-browser",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic_with_mcp/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "fs-browser",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["title", "subtitle", "body"]
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Local files over MCP",
          "variant": "h2"
        },
        {
          "id": "subtitle",
          "component": "Text",
          "text": "Every control on this page is a callMcpTool call against the reference filesystem MCP server. The payload carries the JSONata that turns each response into data model updates.",
          "variant": "caption"
        },
        {
          "id": "body",
          "component": "Row",
          "children": ["left_pane", "right_pane"]
        },
        {
          "id": "left_pane",
          "component": "Column",
          "weight": 1,
          "children": ["top_card", "entries_card"]
        },
        {
          "id": "top_card",
          "component": "Card",
          "child": "controls_row"
        },
        {
          "id": "controls_row",
          "component": "Row",
          "children": ["nav_column", "search_column"]
        },
        {
          "id": "nav_column",
          "component": "Column",
          "weight": 1,
          "children": ["path_field", "nav_row"]
        },
        {
          "id": "path_field",
          "component": "TextField",
          "label": "Directory",
          "value": {
            "path": "/args/open/path"
          }
        },
        {
          "id": "nav_row",
          "component": "Row",
          "children": ["open_button", "parent_button", "home_button"]
        },
        {
          "id": "open_button",
          "component": "Button",
          "variant": "primary",
          "child": "open_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/open"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "open_button_text",
          "component": "Text",
          "text": "List directory"
        },
        {
          "id": "parent_button",
          "component": "Button",
          "child": "parent_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/parent"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "parent_button_text",
          "component": "Text",
          "text": "Parent"
        },
        {
          "id": "home_button",
          "component": "Button",
          "child": "home_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/home"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "home_button_text",
          "component": "Text",
          "text": "Home"
        },
        {
          "id": "search_column",
          "component": "Column",
          "weight": 1,
          "children": ["search_field", "search_button"]
        },
        {
          "id": "search_field",
          "component": "TextField",
          "label": "Search in directory (glob)",
          "value": {
            "path": "/args/search/pattern"
          }
        },
        {
          "id": "search_button",
          "component": "Button",
          "child": "search_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "search_files",
                "arguments": {
                  "path": "/args/search"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/search"
                }
              }
            }
          }
        },
        {
          "id": "search_button_text",
          "component": "Text",
          "text": "Search in directory"
        },
        {
          "id": "entries_card",
          "component": "Card",
          "child": "entries_column"
        },
        {
          "id": "entries_column",
          "component": "Column",
          "children": ["entries_title", "entries_list"]
        },
        {
          "id": "entries_title",
          "component": "Text",
          "text": {
            "path": "/entries_title"
          },
          "variant": "h5"
        },
        {
          "id": "entries_list",
          "component": "List",
          "children": {
            "componentId": "entry_row",
            "path": "/entries"
          }
        },
        {
          "id": "entry_row",
          "component": "Row",
          "children": ["entry_icon", "entry_button", "entry_size"]
        },
        {
          "id": "entry_icon",
          "component": "Icon",
          "name": {
            "path": "icon"
          }
        },
        {
          "id": "entry_button",
          "component": "Button",
          "variant": "borderless",
          "weight": 1,
          "child": "entry_name",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": {
                  "path": "tool"
                },
                "arguments": {
                  "path": "args"
                },
                "dataModelUpdateJsonata": {
                  "path": "jsonata"
                }
              }
            }
          }
        },
        {
          "id": "entry_name",
          "component": "Text",
          "text": {
            "path": "name"
          }
        },
        {
          "id": "entry_size",
          "component": "Text",
          "text": {
            "path": "size"
          },
          "variant": "caption"
        },
        {
          "id": "right_pane",
          "component": "Column",
          "weight": 1,
          "children": ["viewer_card"]
        },
        {
          "id": "viewer_card",
          "component": "Card",
          "child": "viewer_column"
        },
        {
          "id": "viewer_column",
          "component": "Column",
          "children": ["viewer_title", "viewer_body"]
        },
        {
          "id": "viewer_title",
          "component": "Text",
          "text": {
            "path": "/viewer_title"
          },
          "variant": "h5"
        },
        {
          "id": "viewer_body",
          "component": "Text",
          "text": {
            "path": "/viewer_body"
          }
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "fs-browser",
      "value": {
        "entries": [],
        "entries_title": "Loading your home directory",
        "search_results": [],
        "viewer_title": "No file open",
        "viewer_body": "Choose a file on the left to read it.",
        "args": {
          "open": {
            "path": "~"
          },
          "parent": {
            "path": "~"
          },
          "home": {
            "path": "~"
          },
          "search": {
            "path": "~",
            "pattern": "**/*.md"
          }
        },
        "jsonata": {
          "list": "( $dir := $args.path ? $args.path : '~'; $isRoot := ($dir = '~' or $dir = '' or $dir = '.'); $childPath := function($name) { $isRoot ? $name : ($dir & '/' & $name) }; $parentDir := ($isRoot or $not($contains($dir, '/'))) ? '~' : $replace($dir, /\\/[^/]+$/, ''); $rows := [ $split($join(content[type = 'text'].text, '\\n'), '\\n')[$contains($, /^\\[(DIR|FILE)\\]/)].( $g := $match($, /^\\[(DIR|FILE)\\]\\s+(.+?)(?:\\s\\s+([0-9.]+ [A-Za-z]+))?\\s*$/).groups; $isDir := $g[0] = 'DIR'; $p := $childPath($g[1]); { 'name': $g[1], 'path': $p, 'size': $g[2] ? $g[2] : '', 'icon': $isDir ? 'folder' : 'attachFile', 'tool': $isDir ? 'list_directory_with_sizes' : 'read_text_file', 'args': { 'path': $p }, 'jsonata': $isDir ? { 'path': '/jsonata/list' } : { 'path': '/jsonata/read' } } ) ]; { '/entries': $rows, '/entries_title': $string($count($rows)) & ($count($rows) = 1 ? ' entry' : ' entries'), '/args/open/path': $dir, '/args/parent/path': $parentDir, '/args/search/path': $dir, '/viewer_title': $isRoot ? 'Home Directory (~)' : $dir, '/viewer_body': 'Choose a file on the left to read it.' } )",
          "read": "{ '/viewer_body': '```\\n' & $join($split($join(content[type = 'text'].text, '\\n'), '\\n')[[0..200]], '\\n') & '\\n```', '/viewer_title': $args.path ? $args.path : 'File Content', '/args/open/path': $args.path ? $args.path : '' }",
          "search": "( $hits := [ $split($join(content[type = 'text'].text, '\\n'), '\\n')[$ != '' and $not($contains($, 'No matches'))].( { 'name': $, 'path': $, 'size': '', 'icon': 'attachFile', 'tool': 'read_text_file', 'args': { 'path': $ }, 'jsonata': { 'path': '/jsonata/read' } } ) ]; { '/entries': $hits, '/entries_title': 'Search: ' & $string($count($hits)) & ($count($hits) = 1 ? ' match' : ' matches') & ' in `' & ($args.path ? $args.path : '~') & '`', '/viewer_title': 'Search in ' & ($args.path ? $args.path : '~'), '/viewer_body': $count($hits) > 0 ? ('Found ' & $string($count($hits)) & ($count($hits) = 1 ? ' match' : ' matches') & ' for glob `' & ($args.pattern ? $args.pattern : '**/*.md') & '` in `' & ($args.path ? $args.path : '~') & '`. Select a file on the left to read it.') : ('No matches found for glob `' & ($args.pattern ? $args.pattern : '**/*.md') & '` in `' & ($args.path ? $args.path : '~') & '`.') } )"
        },
        "startup": [
          {
            "name": "list_directory_with_sizes",
            "arguments": {
              "path": "~"
            },
            "dataModelUpdateJsonata": {
              "path": "/jsonata/list"
            }
          }
        ]
      }
    }
  }
]
