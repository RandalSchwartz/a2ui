[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "fs-browser",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic_with_mcp/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "fs-browser",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["title", "subtitle", "body"]
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Local files over MCP",
          "variant": "h2"
        },
        {
          "id": "subtitle",
          "component": "Text",
          "text": "Every control on this page is a callMcpTool call against the reference filesystem MCP server. The payload carries the JSONata that turns each response into data model updates.",
          "variant": "caption"
        },
        {
          "id": "body",
          "component": "Row",
          "children": ["left_pane", "right_pane"]
        },
        {
          "id": "left_pane",
          "component": "Column",
          "weight": 1,
          "children": ["nav_card", "entries_card", "search_card"]
        },
        {
          "id": "nav_card",
          "component": "Card",
          "child": "nav_column"
        },
        {
          "id": "nav_column",
          "component": "Column",
          "children": ["path_field", "nav_row"]
        },
        {
          "id": "path_field",
          "component": "TextField",
          "label": "Directory",
          "value": {
            "path": "/args/open/path"
          }
        },
        {
          "id": "nav_row",
          "component": "Row",
          "children": ["open_button", "parent_button", "home_button"]
        },
        {
          "id": "open_button",
          "component": "Button",
          "variant": "primary",
          "child": "open_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/open"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "open_button_text",
          "component": "Text",
          "text": "List directory"
        },
        {
          "id": "parent_button",
          "component": "Button",
          "child": "parent_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/parent"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "parent_button_text",
          "component": "Text",
          "text": "Parent"
        },
        {
          "id": "home_button",
          "component": "Button",
          "child": "home_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "list_directory_with_sizes",
                "arguments": {
                  "path": "/args/home"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/list"
                }
              }
            }
          }
        },
        {
          "id": "home_button_text",
          "component": "Text",
          "text": "Home"
        },
        {
          "id": "entries_card",
          "component": "Card",
          "child": "entries_column"
        },
        {
          "id": "entries_column",
          "component": "Column",
          "children": ["entries_title", "entries_list"]
        },
        {
          "id": "entries_title",
          "component": "Text",
          "text": {
            "path": "/entries_title"
          },
          "variant": "h5"
        },
        {
          "id": "entries_list",
          "component": "List",
          "children": {
            "componentId": "entry_row",
            "path": "/entries"
          }
        },
        {
          "id": "entry_row",
          "component": "Row",
          "children": ["entry_icon", "entry_button", "entry_size"]
        },
        {
          "id": "entry_icon",
          "component": "Icon",
          "name": {
            "path": "icon"
          }
        },
        {
          "id": "entry_button",
          "component": "Button",
          "variant": "borderless",
          "weight": 1,
          "child": "entry_name",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": {
                  "path": "tool"
                },
                "arguments": {
                  "path": "args"
                },
                "dataModelUpdateJsonata": {
                  "path": "jsonata"
                }
              }
            }
          }
        },
        {
          "id": "entry_name",
          "component": "Text",
          "text": {
            "path": "name"
          }
        },
        {
          "id": "entry_size",
          "component": "Text",
          "text": {
            "path": "size"
          },
          "variant": "caption"
        },
        {
          "id": "search_card",
          "component": "Card",
          "child": "search_column"
        },
        {
          "id": "search_column",
          "component": "Column",
          "children": ["search_field", "search_button", "search_list"]
        },
        {
          "id": "search_field",
          "component": "TextField",
          "label": "Glob, searched below this directory",
          "value": {
            "path": "/args/search/pattern"
          }
        },
        {
          "id": "search_button",
          "component": "Button",
          "child": "search_button_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "search_files",
                "arguments": {
                  "path": "/args/search"
                },
                "dataModelUpdateJsonata": {
                  "path": "/jsonata/search"
                }
              }
            }
          }
        },
        {
          "id": "search_button_text",
          "component": "Text",
          "text": "Run search_files"
        },
        {
          "id": "search_list",
          "component": "List",
          "children": {
            "componentId": "search_row",
            "path": "/search_results"
          }
        },
        {
          "id": "search_row",
          "component": "Button",
          "variant": "borderless",
          "child": "search_row_text",
          "action": {
            "functionCall": {
              "call": "callMcpTool",
              "args": {
                "name": "read_text_file",
                "arguments": {
                  "path": "args"
                },
                "dataModelUpdateJsonata": {
                  "path": "jsonata"
                }
              }
            }
          }
        },
        {
          "id": "search_row_text",
          "component": "Text",
          "text": {
            "path": "label"
          },
          "variant": "caption"
        },
        {
          "id": "right_pane",
          "component": "Column",
          "weight": 1,
          "children": ["viewer_card"]
        },
        {
          "id": "viewer_card",
          "component": "Card",
          "child": "viewer_column"
        },
        {
          "id": "viewer_column",
          "component": "Column",
          "children": ["viewer_title", "viewer_body"]
        },
        {
          "id": "viewer_title",
          "component": "Text",
          "text": {
            "path": "/viewer_title"
          },
          "variant": "h5"
        },
        {
          "id": "viewer_body",
          "component": "Text",
          "text": {
            "path": "/viewer_body"
          }
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "fs-browser",
      "value": {
        "entries": [],
        "entries_title": "Loading your home directory",
        "search_results": [],
        "viewer_title": "No file open",
        "viewer_body": "Choose a file on the left to read it.",
        "args": {
          "open": {
            "path": "~"
          },
          "parent": {
            "path": "~"
          },
          "home": {
            "path": "~"
          },
          "search": {
            "path": "~",
            "pattern": "**/*.md"
          }
        },
        "jsonata": {
          "list": "( $rows := [ $split($join(content[type = 'text'].text, '\\n'), '\\n')[$contains($, /^\\[(DIR|FILE)\\]/)].( $g := $match($, /^\\[(DIR|FILE)\\]\\s+(.+?)(?:\\s\\s+([0-9.]+ [A-Za-z]+))?\\s*$/).groups; $isDir := $g[0] = 'DIR'; { 'name': $g[1], 'size': $g[2] ? $g[2] : '', 'icon': $isDir ? 'folder' : 'attachFile', 'tool': $isDir ? 'list_directory_with_sizes' : 'read_text_file', 'args': { 'path': $g[1] }, 'jsonata': $isDir ? { 'path': '/jsonata/list' } : { 'path': '/jsonata/read' } } ) ]; { '/entries': $rows, '/entries_title': $string($count($rows)) & ($count($rows) = 1 ? ' entry' : ' entries') } )",
          "read": "{ '/viewer_body': '```\\n' & $join($split($join(content[type = 'text'].text, '\\n'), '\\n')[[0..120]], '\\n') & '\\n```' }",
          "search": "( $hits := [ $split($join(content[type = 'text'].text, '\\n'), '\\n')[$ != '' and $not($contains($, 'No matches'))].{ 'label': $, 'args': { 'path': $ }, 'jsonata': { 'path': '/jsonata/read' } } ]; { '/search_results': $hits, '/viewer_body': 'Matches: ' & $string($count($hits)) } )"
        },
        "startup": [
          {
            "name": "list_directory_with_sizes",
            "arguments": {
              "path": "~"
            },
            "dataModelUpdateJsonata": {
              "path": "/jsonata/list"
            }
          }
        ]
      }
    }
  }
]
